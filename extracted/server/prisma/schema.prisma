generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id @default(cuid())
  name            String
  email           String             @unique
  role            String             // 'admin' | 'employee'
  department      String
  employeeId      String             @unique
  hourlyRate      Float
  masterPhoto     String?            // Base64 or URL
  officeLat       Float
  officeLng       Float
  officeRadius    Float              @default(20)
  officeAddress   String
  attendance      AttendanceRecord[]
  leaves          LeaveRequest[]
  expenses        ExpenseRequest[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model AttendanceRecord {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  userName          String
  date              String            // yyyy-MM-dd
  clockInTime       String?
  clockInLat        Float?
  clockInLng        Float?
  clockInMethod     String?           // 'gps' | 'qr' | 'manual'
  clockInPhoto      String?
  clockOutTime      String?
  clockOutLat       Float?
  clockOutLng       Float?
  clockOutMethod    String?
  clockOutPhoto     String?
  status            String            // 'present' | 'late' | 'absent' | 'pending_correction'
  totalHours        Float             @default(0)
  isLate            Boolean           @default(false)
  lateMinutes       Int               @default(0)
  lateReason        String?
  mood              String?
  correctionRequest CorrectionRequest?
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime          @default(now())
}

model CorrectionRequest {
  id             String           @id @default(cuid())
  recordId       String           @unique
  record         AttendanceRecord @relation(fields: [recordId], references: [id])
  requestedTime  String
  reason         String
  status         String           @default("pending") // "pending" | "approved" | "rejected"
}

model LeaveRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // 'Sick' | 'Annual' | 'Casual' | 'Study'
  startDate String
  endDate   String
  reason    String
  status    String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt DateTime @default(now())
}

model ExpenseRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  userName    String
  title       String
  amount      Float
  category    String
  date        String
  description String?
  receipt     String?  // URL or Base64
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt   DateTime @default(now())
}

model BroadcastMessage {
  id          String   @id @default(cuid())
  senderName  String
  message     String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
}
