{
  "name": "dala-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon --exec \"ts-node --transpile-only src/index.ts\"",
    "prisma:generate": "prisma generate",
    "build": "npm run prisma:generate && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "db:init": "ts-node scripts/bootstrap-db.ts",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:backup": "ts-node scripts/export-db-backup.ts",
    "db:seed-snapshot": "ts-node scripts/export-seed-snapshot.ts",
    "smoke:test": "ts-node scripts/smoke-test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
